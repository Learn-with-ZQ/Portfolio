# Google Apps Script Web App URL that appends contact-form submissions
# to your Google Sheet. See "Contact form" in README.md for the setup.
CONTACT_WEBHOOK_URL=

# Testimonial Google Apps Script Web App URL
TESTIMONIAL_WEBHOOK_URL=

# Your production domain (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=

# Google OAuth for Auth.js / NextAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Optional Twitter/X handle for Twitter Card metadata (e.g. @yourhandle)
NEXT_PUBLIC_TWITTER_HANDLE=

# Search Console / webmaster verification (optional — add after claiming the site)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
