# Your production domain (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=

# Google OAuth for Auth.js / NextAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Optional Twitter/X handle for Twitter Card metadata (e.g. @yourhandle)
NEXT_PUBLIC_TWITTER_HANDLE=

# Search Console / webmaster verification (optional — add after claiming the site)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Chat assistant (the corner mascot). Free API key from https://aistudio.google.com/apikey
# — separate from a Gemini app subscription. Without it the chat says it's unavailable.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Portfolio API (ASP.NET Core + PostgreSQL): serves the site's content and saves
# contact messages and testimonials. No trailing slash needed. Content is
# cached for 10 minutes and falls back to the bundled src/data/*.ts files when
# this is empty or the API can't be reached; the contact form and testimonials
# need it.
PORTFOLIO_API_URL=

# The key the site sends the API (X-Site-Key) to save contact messages. Must
# equal the API's SiteKey. Generate one with `openssl rand -hex 32`.
PORTFOLIO_API_SITE_KEY=
